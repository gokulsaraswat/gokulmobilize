# Names only, never values. Copy to .env.local for local work.

# GitHub token with read:packages, needed by `npm ci` for @gokulsaraswat/* (.npmrc). Set it in your shell, CI secrets and Vercel env, not in a file.
NODE_AUTH_TOKEN=

# URL of the hub config.json (Supabase Storage public bucket; path comes from admin). Unset = public/config.mock.json.
PUBLIC_HUB_CONFIG_URL=

# Native (Capacitor) build only: public origin of the one-domain site, e.g. https://example.com. Remote tiles (portfolio, gym, admin) open there in the in-app browser. Unset = remote tiles hidden in the app.
PUBLIC_SITE_ORIGIN=
