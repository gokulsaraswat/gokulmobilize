---
import '@gokulsaraswat/ui/tokens.css';
import '@gokulsaraswat/ui/styles.css';
import { Footer } from '@gokulsaraswat/ui';
import { FileLink } from '../components/FileLink';
import AccountMenu from '../components/auth/AccountMenu';
import { readAuthConfig } from '../lib/account';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'All of Gokul Saraswat’s apps in one place.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const native = import.meta.env.PUBLIC_HUB_NATIVE === 'true';
const authConfig = native ? null : readAuthConfig(import.meta.env);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon-180x180.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <title>{title}</title>
  </head>
  <body>
    {authConfig && (
      <header class="hub-bar">
        <AccountMenu client:idle config={authConfig} />
      </header>
    )}
    <main><slot /></main>
    <Footer siteName="Gokul’s apps" basePath={base} linkComponent={native ? FileLink : undefined} />
  </body>
</html>

<script>
  if (import.meta.env.PROD && import.meta.env.PUBLIC_HUB_NATIVE !== 'true' && 'serviceWorker' in navigator) {
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    navigator.serviceWorker.register(`${base}/sw.js`, { scope: `${base}/` });
  }
</script>

<style is:global>
  @view-transition {
    navigation: auto;
  }
  body {
    margin: 0;
    background: var(--background);
    color: var(--foreground);
    font-family: var(--font-sans);
  }
  .hub-bar {
    max-width: 64rem;
    min-height: 2.5rem;
    margin-inline: auto;
    padding: 1rem 1rem 0;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }
  main {
    max-width: 64rem;
    margin-inline: auto;
    padding: 1.5rem 1rem 3rem;
  }
</style>
