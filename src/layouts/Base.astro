---
import '@gokulsaraswat/ui/tokens.css';
import '@gokulsaraswat/ui/styles.css';
import { Footer } from '@gokulsaraswat/ui';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'All of Gokul Saraswat’s apps in one place.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <main><slot /></main>
    <Footer siteName="Gokul’s apps" basePath={base} />
  </body>
</html>

<style is:global>
  @view-transition {
    navigation: auto;
  }
  body {
    margin: 0;
    background: var(--background);
    color: var(--foreground);
    font-family: var(--font-sans);
  }
  main {
    max-width: 64rem;
    margin-inline: auto;
    padding: 1.5rem 1rem 3rem;
  }
</style>
