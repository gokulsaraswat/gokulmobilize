{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/apps/",
      "permanent": false
    },
    {
      "source": "/apps",
      "destination": "/apps/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/apps/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(apps/)?sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
